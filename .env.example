# Vite exposes only variables prefixed with VITE_ to client code.
# Copy this file to .env.local and fill in the values you actually use.
# .env.local is git-ignored.

# Tracking master switch. Set to "true" to enable analytics scripts.
VITE_ENABLE_TRACKING=false

# Hotjar
VITE_HOTJAR_WEBSITE_UID=
VITE_HOTJAR_VERSION=6

# Google Tag Manager / Google Analytics
VITE_GOOGLE_TAG_MANAGER_UID=

# Microsoft Clarity
VITE_MICROSOFT_CLARITY_UID=

# DebugBear RUM
VITE_DEBUGBEAR_RUM_UID=

# Formspree contact form (https://formspree.io) — the 8-char form ID
VITE_FORMSPREE_FORM_ID=

# Disqus shortname for blog post comments (https://disqus.com/admin)
VITE_DISQUS_SHORTNAME=

# Calendly URL for the "Chat with Sal" CTA
VITE_CALENDLY_URL=

# Canonical site URL (used in metadata)
VITE_SITE_URL=https://www.sal-anvarov.com
